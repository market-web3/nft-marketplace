# ZK Circuits Environment Configuration

# Circom version
CIRCOM_VERSION=2.1.6

# Powers of Tau ceremony file (trusted setup)
PTAU_FILE=pot20_final.ptau

# SnarkJS configuration
SNARKJS_VERSION=0.7.0

# Circuit configuration
CIRCUIT_NAME=commitment
CIRCUIT_DEPTH=20
CIRCUIT_BITS=64

# Prime field (for snarkjs)
PRIME_FIELD=bn128

# Build output directories
BUILD_DIR=build
PROVING_KEY_DIR=keys
VERIFICATION_KEY_DIR=keys
WASM_DIR=build

# Solidity verification contract output
CONTRACTS_DIR=solidity

# Optimization level (0=none, 1=O1, 2=O2)
OPTIMIZATION_LEVEL=2

# Verbose output
VERBOSE=1

# Parallel compilation (number of cores)
PARALLEL=4
