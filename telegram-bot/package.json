{
  "name": "nft-marketplace-telegram-bot",
  "version": "2.0.0",
  "description": "Telegram Bot for NFT Marketplace with Telethon integration for off-chain gift management",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "telegram:auth": "ts-node src/scripts/auth.ts"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "node-telegram-bot-api": "^0.64.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "telegraf": "^4.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/node-telegram-bot-api": "^0.64.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
