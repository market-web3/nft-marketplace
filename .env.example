# ============================================
# TON NFT Marketplace - Environment Variables
# ============================================

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/nft_marketplace
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nft_marketplace
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# TON Blockchain
# ============================================
TON_API_KEY=your_toncenter_api_key
TON_NETWORK=testnet
TON_CONTRACT_ADDRESS=EQ...
TON_ADMIN_WALLET_MNEMONIC=word1 word2 word3 ... word24
TON_DEPOSIT_WALLET_ADDRESS=EQ...
TON_WITHDRAW_WALLET_ADDRESS=EQ...
TON_MARKETPLACE_FEE_PERCENT=250

# ============================================
# Security
# ============================================
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
ENCRYPTION_KEY=your_encryption_key

# ============================================
# Frontend
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TON_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=EQ...
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=https://your-domain.com/tonconnect-manifest.json

# ============================================
# Admin Panel
# ============================================
ADMIN_API_URL=http://localhost:3001
ADMIN_JWT_SECRET=your_admin_jwt_secret

# ============================================
# Telegram Bot
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3002

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# External Services
# ============================================
# IPFS (Pinata or similar)
IPFS_API_KEY=your_ipfs_api_key
IPFS_SECRET_KEY=your_ipfs_secret_key

# CDN
CDN_URL=https://your-cdn.com

# Analytics (optional)
ANALYTICS_ID=your_analytics_id
