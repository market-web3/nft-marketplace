# ============================================
# TON NFT Marketplace - Environment Variables
# ============================================

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/nft_marketplace
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nft_marketplace
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# TON Blockchain
# ============================================
TON_API_KEY=your_toncenter_api_key
TON_NETWORK=testnet
TON_CONTRACT_ADDRESS=EQ...
TON_ADMIN_WALLET_MNEMONIC=word1 word2 word3 ... word24
TON_DEPOSIT_WALLET_ADDRESS=EQ...
TON_WITHDRAW_WALLET_ADDRESS=EQ...
TON_MARKETPLACE_FEE_PERCENT=250

# ============================================
# Security
# ============================================
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
ENCRYPTION_KEY=your_encryption_key

# ============================================
# Frontend
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TON_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=EQ...
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=https://your-domain.com/tonconnect-manifest.json

# ============================================
# Admin Panel
# ============================================
ADMIN_API_URL=http://localhost:3001
ADMIN_JWT_SECRET=your_admin_jwt_secret

# ============================================
# Telegram Bot
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3002

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# External Services
# ============================================
# IPFS (Pinata or similar)
IPFS_API_KEY=your_ipfs_api_key
IPFS_SECRET_KEY=your_ipfs_secret_key

# CDN
CDN_URL=https://your-cdn.com

# Analytics (optional)
ANALYTICS_ID=your_analytics_id

# ============================================
# Apache Kafka
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ============================================
# ScyllaDB
# ============================================
SCYLLA_NODES=localhost:9042
SCYLLA_USERNAME=
SCYLLA_PASSWORD=

# ============================================
# AI Embeddings Service
# ============================================
EMBEDDINGS_SERVICE_URL=http://localhost:8001
CLIP_MODEL=ViT-B/32
EMBEDDING_DIM=512

# ============================================
# AI Trust Engine
# ============================================
TRUST_ENGINE_URL=http://localhost:8002
MODEL_PATH=./models/trust_gnn.pt

# ============================================
# Gasless Relayer
# ============================================
RELAYER_URL=http://localhost:3005
RELAYER_PRIVATE_KEY=your_relayer_private_key
RELAYER_FEE_PERCENT=100

# ============================================
# Cross-Chain Bridges
# ============================================
LAYERZERO_ENDPOINT=your_layerzero_endpoint
WORMHOLE_GUARDIAN=your_wormhole_guardian
SUPPORTED_CHAINS=ton,ethereum,solana,bsc,arbitrum,optimism,polygon

# ============================================
# ZK-SNARKs
# ============================================
ZK_CIRCUITS_PATH=./zk-circuits
ZK_VERIFICATION_KEYS_PATH=./zk-circuits/keys
ZK_PROVING_KEYS_PATH=./zk-circuits/keys

# ============================================
# Indexer
# ============================================
INDEXER_START_BLOCK_SEQNO=0
INDEXER_POLL_INTERVAL_MS=1000
INDEXER_MAX_CONSECUTIVE_ERRORS=10
INDEXER_METRICS_PORT=9090
