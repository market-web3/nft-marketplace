;; ============================================
;; UTILITY FUNCTIONS
;; ============================================

;; Slice hash
int slice_hash(slice s) inline {
    return slice_hash(s);
}

;; Address none
slice addr_none() inline {
    return begin_cell().store_uint(0, 2).end_cell().begin_parse();
}

;; Calculate cell hash
int cell_hash(cell c) inline {
    return cell_hash(c);
}

;; Check if slice is valid address
int is_valid_address(slice s) inline {
    return s.slice_bits() == 267;
}

;; Parse address from slice
(slice, slice) parse_address(slice s) inline {
    return s~load_msg_addr();
}

;; Build address
cell build_address(int workchain, int hash) inline {
    return begin_cell()
        .store_uint(2, 2)  ;; addr_std$10
        .store_uint(0, 1) ;; anycast absent
        .store_int(workchain, 8)
        .store_uint(hash, 256)
        .end_cell();
}

;; Serialize uint256 to cell
cell serialize_uint256(int value) inline {
    return begin_cell().store_uint(value, 256).end_cell();
}

;; Deserialize uint256 from cell
int deserialize_uint256(cell c) inline {
    return c.begin_parse()~load_uint(256);
}

;; ============================================
;; TIME UTILITIES
;; ============================================

;; Get current time
int get_now() inline {
    return now();
}

;; Check if expired
int is_expired(int expiry_time) inline {
    return now() >= expiry_time;
}

;; Calculate days to seconds
int days_to_seconds(int days) inline {
    return days * 86400;
}

;; Calculate hours to seconds
int hours_to_seconds(int hours) inline {
    return hours * 3600;
}

;; ============================================
;; MATH UTILITIES
;; ============================================

;; Min of two values
int min(int a, int b) inline {
    return a < b ? a : b;
}

;; Max of two values
int max(int a, int b) inline {
    return a > b ? a : b;
}

;; Clamp value between min and max
int clamp(int value, int min_val, int max_val) inline {
    return max(min_val, min(value, max_val));
}

;; Calculate percentage
int calculate_percentage(int amount, int percent, int precision) inline {
    return (amount * percent) / precision;
}

;; Safe add with overflow check
(int, int) safe_add(int a, int b) inline {
    int result = a + b;
    int overflow = result < a;
    return (result, overflow);
}

;; Safe subtract with underflow check
(int, int) safe_sub(int a, int b) inline {
    int underflow = b > a;
    int result = underflow ? 0 : a - b;
    return (result, underflow);
}
