;; ============================================
;; FIXED PRICE LISTING
;; ============================================

() op_list_nft(
    slice sender,
    int query_id,
    slice in_msg_body,
    int msg_value,
    slice admin,
    slice deposit,
    slice withdraw,
    slice vbm,
    int fee_percent,
    int min_wd,
    int vol,
    int trades,
    int total_nfts,
    int is_paused,
    cell categories,
    cell listings,
    cell offers,
    cell auctions
) impure inline {
    throw_if(ERR_CONTRACT_PAUSED, is_paused);
    
    slice nft_address = in_msg_body~load_msg_addr();
    int category_id = in_msg_body~load_uint(256);
    int price = in_msg_body~load_coins();
    
    throw_unless(ERR_PRICE_TOO_LOW, price >= MIN_LISTING_PRICE);
    
    int listing_id = generate_id(nft_address, sender~hash(), now());
    int created_at = now();
    int expires_at = created_at + (MAX_AUCTION_DAYS * DAY_IN_SECONDS);
    
    cell listing_data = begin_cell()
        .store_slice(nft_address)
        .store_slice(sender)
        .store_coins(price)
        .store_uint(category_id, 256)
        .store_uint(created_at, 64)
        .store_uint(expires_at, 64)
        .store_uint(0, 8)  ;; fixed price
        .store_ref(begin_cell().end_cell())
        .end_cell();
    
    listings~udict_set(256, listing_id, listing_data);
    
    var msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(sender)
        .store_coins(0)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(OP_NFT_LISTED, 32)
        .store_uint(query_id, 64)
        .store_uint(listing_id, 256)
        .store_msg_addr(nft_address)
        .store_slice(sender)
        .store_coins(price)
        .end_cell();
    
    send_raw_message(msg, 64);
    
    save_storage(admin, deposit, withdraw, vbm, fee_percent, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
}

;; Buy NFT at fixed price
() op_buy_nft(
    slice sender,
    int query_id,
    slice in_msg_body,
    int msg_value,
    slice admin,
    slice deposit,
    slice withdraw,
    slice vbm,
    int fee_percent,
    int min_wd,
    int vol,
    int trades,
    int total_nfts,
    int is_paused,
    cell categories,
    cell listings,
    cell offers,
    cell auctions
) impure inline {
    throw_if(ERR_CONTRACT_PAUSED, is_paused);
    
    int listing_id = in_msg_body~load_uint(256);
    
    (slice listing_data, int exists) = listings.udict_get?(256, listing_id);
    throw_unless(ERR_NOT_FOUND, exists);
    
    slice ls = listing_data.begin_parse();
    slice nft_address = ls~load_msg_addr();
    slice seller = ls~load_msg_addr();
    int price = ls~load_coins();
    int category_id = ls~load_uint(256);
    
    throw_unless(ERR_INSUFFICIENT_FUNDS, msg_value >= price);
    
    ;; Calculate fees
    int marketplace_fee = calculate_fee(price, fee_percent);
    int seller_amount = price - marketplace_fee;
    
    ;; Send fee to deposit wallet
    var fee_msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(deposit)
        .store_coins(marketplace_fee)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(OP_FEE_RECEIVED, 32)
        .store_uint(query_id, 64)
        .store_uint(listing_id, 256)
        .end_cell();
    send_raw_message(fee_msg, 1);
    
    ;; Send payment to seller
    var seller_msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(seller)
        .store_coins(seller_amount)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(OP_SALE_PROCEEDS, 32)
        .store_uint(query_id, 64)
        .store_uint(listing_id, 256)
        .end_cell();
    send_raw_message(seller_msg, 1);
    
    ;; Transfer NFT to buyer
    cell transfer_body = begin_cell()
        .store_uint(0x5fcc3d14, 32)
        .store_uint(query_id, 64)
        .store_slice(sender)
        .store_slice(seller)
        .store_uint(0, 1)
        .store_coins(10000000)
        .store_uint(0, 1)
        .end_cell();
    
    var nft_msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(nft_address)
        .store_coins(GAS_TRANSFER)
        .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_ref(transfer_body)
        .end_cell();
    send_raw_message(nft_msg, 1);
    
    ;; Remove listing
    listings~udict_delete?(256, listing_id);
    
    ;; Update stats
    int new_trades = trades + 1;
    int new_volume = vol + price;
    
    ;; Emit event
    var event_msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(admin)
        .store_coins(0)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(OP_NFT_SOLD, 32)
        .store_uint(query_id, 64)
        .store_uint(listing_id, 256)
        .store_msg_addr(nft_address)
        .store_slice(seller)
        .store_slice(sender)
        .store_coins(price)
        .store_uint(category_id, 256)
        .end_cell();
    
    send_raw_message(event_msg, 64);
    
    save_storage(admin, deposit, withdraw, vbm, fee_percent, min_wd, new_volume, new_trades, total_nfts, is_paused, categories, listings, offers, auctions);
}

;; ============================================
;; MAIN RECEIVE FUNCTION
;; ============================================

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        ;; Simple TON transfer - treat as deposit
        return ();
    }
    
    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);
    
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    
    if (flags & 1) {
        return ();
    }
    
    slice sender = cs~load_msg_addr();
    
    var (admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions) = load_storage();
    
    ;; Admin operations
    if (op == OP_CREATE_CATEGORY) {
        op_create_category(sender, query_id, in_msg_body, admin, categories);
        save_storage(admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    if (op == OP_SET_FEE) {
        op_set_fee(sender, query_id, in_msg_body, admin, deposit, withdraw, vbm, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    if (op == OP_PAUSE_MARKETPLACE) {
        op_set_pause(sender, query_id, in_msg_body, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, categories, listings, offers, auctions);
        return ();
    }
    
    if (op == OP_EMERGENCY_WITHDRAW) {
        op_emergency_withdraw(sender, query_id, in_msg_body, admin, my_balance());
        return ();
    }
    
    ;; Listing operations
    if (op == OP_LIST_NFT) {
        op_list_nft(sender, query_id, in_msg_body, msg_value, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    if (op == OP_BUY_NFT) {
        op_buy_nft(sender, query_id, in_msg_body, msg_value, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    ;; Auction operations
    if (op == OP_CREATE_AUCTION) {
        op_create_auction(sender, query_id, in_msg_body, msg_value, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    if (op == OP_PLACE_BID) {
        op_place_bid(sender, query_id, in_msg_body, msg_value, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    if (op == OP_END_AUCTION) {
        op_end_auction(sender, query_id, in_msg_body, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    ;; Offer operations
    if (op == OP_MAKE_OFFER) {
        op_make_offer(sender, query_id, in_msg_body, msg_value, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    if (op == OP_ACCEPT_OFFER) {
        op_accept_offer(sender, query_id, in_msg_body, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    if (op == OP_REJECT_OFFER) {
        op_reject_offer(sender, query_id, in_msg_body, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    if (op == OP_CANCEL_OFFER) {
        op_cancel_offer(sender, query_id, in_msg_body, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    if (op == OP_CANCEL_EXPIRED_OFFER) {
        op_cancel_expired_offer(sender, query_id, in_msg_body, admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, categories, listings, offers, auctions);
        return ();
    }
    
    throw(ERR_INVALID_OP);
}

;; ============================================
;; GET METHODS
;; ============================================

(int, int, int, int, slice, slice, slice, slice, int, int) get_marketplace_info() method_id {
    var (admin, deposit, withdraw, vbm, fee, min_wd, vol, trades, total_nfts, is_paused, _, _, _, _) = load_storage();
    return (fee, min_wd, vol, trades, admin, deposit, withdraw, vbm, total_nfts, is_paused);
}

(int, int, int, int, int, int, int, slice, int, int) get_auction_info(int auction_id) method_id {
    var (_, _, _, _, _, _, _, _, _, _, _, _, _, auctions) = load_storage();
    
    (slice data, int exists) = auctions.udict_get?(256, auction_id);
    throw_unless(ERR_AUCTION_NOT_FOUND, exists);
    
    slice cs = data.begin_parse();
    int start_price = cs~load_coins();
    int reserve_price = cs~load_coins();
    int min_bid_increment = cs~load_coins();
    int start_time = cs~load_uint(64);
    int end_time = cs~load_uint(64);
    int highest_bid = cs~load_coins();
    slice highest_bidder = cs~load_msg_addr();
    int bid_count = cs~load_uint(32);
    int is_active = cs~load_uint(1);
    
    int time_remaining = end_time > now() ? end_time - now() : 0;
    
    return (start_price, reserve_price, min_bid_increment, highest_bid, bid_count, time_remaining, highest_bidder, is_active, start_time, end_time);
}

(slice, slice, int, int, int, int, int, int) get_offer_info(int offer_id) method_id {
    var (_, _, _, _, _, _, _, _, _, _, _, _, offers, _) = load_storage();
    
    (slice data, int exists) = offers.udict_get?(256, offer_id);
    throw_unless(ERR_OFFER_NOT_FOUND, exists);
    
    slice cs = data.begin_parse();
    int id = cs~load_uint(256);
    slice nft_address = cs~load_msg_addr();
    slice buyer = cs~load_msg_addr();
    slice seller = cs~load_msg_addr();
    int amount = cs~load_coins();
    int created_at = cs~load_uint(64);
    int expires_at = cs~load_uint(64);
    int status = cs~load_uint(8);
    
    int time_remaining = expires_at > now() ? expires_at - now() : 0;
    int is_expired = now() >= expires_at;
    
    return (nft_address, buyer, amount, status, time_remaining, is_expired, created_at, expires_at);
}

int get_active_listings_count() method_id {
    var (_, _, _, _, _, _, _, _, _, _, _, listings, _, _) = load_storage();
    return listings.dict_empty?() ? 0 : listings.dict_count(256);
}

int get_active_offers_count() method_id {
    var (_, _, _, _, _, _, _, _, _, _, _, _, offers, _) = load_storage();
    return offers.dict_empty?() ? 0 : offers.dict_count(256);
}

int get_active_auctions_count() method_id {
    var (_, _, _, _, _, _, _, _, _, _, _, _, _, auctions) = load_storage();
    return auctions.dict_empty?() ? 0 : auctions.dict_count(256);
}
