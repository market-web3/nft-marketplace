const int ERR_HIGHLOAD_MESSAGE_TOO_LARGE = 506;

;; Virtual Balance Errors (600-699)
const int ERR_VIRTUAL_BALANCE_NOT_FOUND = 600;
const int ERR_VIRTUAL_BALANCE_INSUFFICIENT = 601;
const int ERR_VIRTUAL_WITHDRAW_PENDING = 602;
const int ERR_VIRTUAL_DEPOSIT_PENDING = 603;
