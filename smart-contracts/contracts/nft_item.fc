;; ============================================
;; NFT ITEM CONTRACT
;; TEP-62 Compliant NFT Item
;; ============================================

#include "stdlib.fc";
#include "op_codes.fc";
#include "errors.fc";

;; ============================================
;; STORAGE LAYOUT
;; ============================================
;; storage#_ 
;;   index:uint64
;;   collection_address:MsgAddress
;;   owner_address:MsgAddress
;;   content:^Cell
;;   royalty_params:^RoyaltyParams
;;   is_initialized:Bool
;;   = Storage;

;; ============================================
;; LOAD/SAVE STORAGE
;; ============================================
(int, slice, slice, cell, cell, int) load_storage() inline {
    var ds = get_data().begin_parse();
    return (
        ds~load_uint(64),              ;; index
        ds~load_msg_addr(),            ;; collection_address
        ds~load_msg_addr(),            ;; owner_address
        ds~load_ref(),                 ;; content
        ds~load_ref(),                 ;; royalty_params
        ds~load_uint(1)                ;; is_initialized
    );
}

() save_storage(
    int index,
    slice collection_address,
    slice owner_address,
    cell content,
    cell royalty_params,
    int is_initialized
) impure inline {
    set_data(begin_cell()
        .store_uint(index, 64)
        .store_slice(collection_address)
        .store_slice(owner_address)
        .store_ref(content)
        .store_ref(royalty_params)
        .store_uint(is_initialized, 1)
        .end_cell());
}

;; ============================================
;; NFT TRANSFER
;; ============================================

() transfer(
    slice sender,
    int query_id,
    slice new_owner,
    slice response_destination,
    int custom_payload,
    int forward_amount,
    slice forward_payload,
    int msg_value
) impure {
    (int index, slice collection, slice owner, cell content, cell royalty, int initialized) = load_storage();
    
    ;; Check authorization
    throw_unless(ERR_NOT_OWNER, equal_slices(sender, owner));
    throw_unless(ERR_UNAUTHORIZED, initialized);
    
    ;; Validate new owner
    throw_unless(ERR_INVALID_ADDRESS, new_owner.slice_bits() == 267);
    
    ;; Update owner
    save_storage(index, collection, new_owner, content, royalty, initialized);
    
    ;; Send excesses to response destination
    int excess = msg_value - 10000000;  ;; Reserve some for gas
    if (excess > 0 & response_destination.slice_bits() == 267) {
        var msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(response_destination)
            .store_coins(excess)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(OP_EXCESSES, 32)
            .store_uint(query_id, 64)
            .end_cell();
        send_raw_message(msg, 2);
    }
    
    ;; Forward notification if requested
    if (forward_amount > 0) {
        var msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(new_owner)
            .store_coins(forward_amount)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(OP_TRANSFER_NOTIFICATION, 32)
            .store_uint(query_id, 64)
            .store_coins(msg_value)
            .store_slice(forward_payload)
            .end_cell();
        send_raw_message(msg, 1);
    }
    
    ;; Notify collection about transfer
    if (collection.slice_bits() == 267) {
        var msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(collection)
            .store_coins(0)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(OP_OWNERSHIP_ASSIGNED, 32)
            .store_uint(query_id, 64)
            .store_uint(index, 64)
            .store_slice(owner)
            .store_slice(new_owner)
            .end_cell();
        send_raw_message(msg, 64);
    }
}

;; ============================================
;; GET STATIC DATA
;; ============================================

() get_static_data(
    slice sender,
    int query_id
) impure {
    (int index, slice collection, slice owner, cell content, cell royalty, int initialized) = load_storage();
    
    var msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(sender)
        .store_coins(0)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(OP_REPORT_STATIC_DATA, 32)
        .store_uint(query_id, 64)
        .store_uint(index, 64)
        .store_slice(collection)
        .store_ref(content)
        .end_cell();
    
    send_raw_message(msg, 64);
}

;; ============================================
;; GET ROYALTY PARAMS
;; ============================================

() get_royalty_params(
    slice sender,
    int query_id
) impure {
    (int index, slice collection, slice owner, cell content, cell royalty, int initialized) = load_storage();
    
    var msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(sender)
        .store_coins(0)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(OP_REPORT_ROYALTY_PARAMS, 32)
        .store_uint(query_id, 64)
        .store_ref(royalty)
        .end_cell();
    
    send_raw_message(msg, 64);
}

;; ============================================
;; MAIN RECEIVE FUNCTION
;; ============================================

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }
    
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    
    if (flags & 1) {
        ;; Bounced message
        return ();
    }
    
    slice sender = cs~load_msg_addr();
    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);
    
    if (op == OP_TRANSFER) {
        slice new_owner = in_msg_body~load_msg_addr();
        slice response_destination = in_msg_body~load_msg_addr();
        int custom_payload = in_msg_body~load_uint(1);
        int forward_amount = in_msg_body~load_coins();
        int forward_payload_in_ref = in_msg_body~load_uint(1);
        slice forward_payload = forward_payload_in_ref ? in_msg_body~load_ref().begin_parse() : in_msg_body;
        
        transfer(sender, query_id, new_owner, response_destination, 
                 custom_payload, forward_amount, forward_payload, msg_value);
        return ();
    }
    
    if (op == OP_GET_STATIC_DATA) {
        get_static_data(sender, query_id);
        return ();
    }
    
    if (op == OP_GET_ROYALTY_PARAMS) {
        get_royalty_params(sender, query_id);
        return ();
    }
    
    throw(ERR_INVALID_OP);
}

;; ============================================
;; GET METHODS
;; ============================================

(int, slice, slice, cell) get_nft_data() method_id {
    (int index, slice collection, slice owner, cell content, cell royalty, int initialized) = load_storage();
    return (initialized, index, collection, owner);
}

slice get_nft_content(int index, cell individual_content) method_id {
    (int idx, slice collection, slice owner, cell content, cell royalty, int initialized) = load_storage();
    
    if (individual_content.cell_null?()) {
        return content.begin_parse();
    }
    
    ;; Merge common and individual content
    return individual_content.begin_parse();
}

slice get_nft_owner() method_id {
    (_, _, slice owner, _, _, _) = load_storage();
    return owner;
}

slice get_nft_collection() method_id {
    (_, slice collection, _, _, _, _) = load_storage();
    return collection;
}

cell get_royalty_params() method_id {
    (_, _, _, _, cell royalty, _) = load_storage();
    return royalty;
}
